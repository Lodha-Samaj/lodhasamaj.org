<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <title>लोधा समाज इंदौर — दानदाता रील</title>
  <!--
    The shots of the दानदाता reel, one per ?shot=: title, totals, roll, band
    and thanks. tools/make_donor_reel.py photographs each and cuts them
    together.

    Like reel-intro-endcard.html.in this is a template, not a page of the site:
    it needs /assets/ and /data/ to resolve, so it is copied to
    .donor-reel.html at the root for the shoot and removed after. The dot keeps
    it out of Pages and out of both of the repo's path guards.

    Nothing here is typed in by hand that the data already says. The names,
    gifts and totals are read from data/donors-<year>.json and worded by
    assets/js/donors-core.js - the same code the दान page uses - so the reel
    cannot say "किलो" where the list says something else, or carry a total the
    list has since corrected. The भंडारा's date and place come from
    data/events.json.
  -->
  <link rel="stylesheet" href="/assets/css/site.css">
  <style>
    html, body { margin: 0; }
    body {
      width: 540px; color: #fff; text-align: center;
      background: var(--ind-d);
    }
    section { display: none; position: relative; width: 540px; box-sizing: border-box; }
    body[data-shot="title"]  #title,
    body[data-shot="totals"] #totals,
    body[data-shot="roll"]   #roll,
    body[data-shot="band"]   #band,
    body[data-shot="thanks"] #thanks { display: block; }
    body[data-shot="totals"] #totals { display: flex; }
    /* The band is laid over the moving roll, so it is shot without a page behind it. */
    body[data-shot="band"] { background: transparent; }

    .jai { margin: 0; font-family: var(--head); font-size: 1.35rem; color: var(--gold); }
    .ord { margin: 14px 0 0; color: var(--mar); font-size: 1.12rem; letter-spacing: 0.02em; }

    /* ---- title ---- */
    #title { height: 960px; overflow: hidden; }
    #title .photo {
      position: absolute; inset: 0 0 auto 0; height: 640px;
      background: center 18% / cover no-repeat;
    }
    #title .photo::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(to bottom, rgba(44, 35, 72, 0) 45%, var(--ind-d) 98%);
    }
    #title .words { position: absolute; inset: auto 0 64px 0; padding: 0 36px; }
    #title h1 {
      margin: 14px 0 0; font-family: var(--head); font-weight: 400;
      font-size: 2.05rem; line-height: 1.3; color: #fff;
    }
    #title .year {
      display: block; margin-top: 6px; font-family: var(--body); font-weight: 800;
      font-size: 3.6rem; line-height: 1; color: var(--gold);
    }
    .count {
      display: inline-block; margin-top: 22px; padding: 10px 24px;
      border: 2px solid var(--gold); border-radius: 10px;
      font-weight: 700; font-size: 1.5rem;
    }

    /* ---- totals ---- */
    #totals {
      height: 960px; padding: 0 34px 40px;
      display: none; flex-direction: column; justify-content: center;
      background: radial-gradient(120% 60% at 50% 0%, rgba(232, 163, 61, 0.22), transparent 62%), var(--ind-d);
    }
    #totals .big { margin: 18px 0 0; font-weight: 800; font-size: 6.2rem; line-height: 1; color: var(--gold); }
    #totals .big + p { margin: 4px 0 0; font-family: var(--head); font-size: 1.9rem; }
    #totals dl {
      display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
      margin: 40px 0 0; text-align: left;
    }
    #totals dl div {
      padding: 12px 16px; border-radius: var(--r);
      background: rgba(255, 255, 255, 0.07); border-left: 3px solid var(--mar);
    }
    #totals dt { font-size: 1.02rem; color: #e6dff5; }
    #totals dd { margin: 2px 0 0; font-weight: 700; font-size: 1.5rem; }
    #totals .also { margin: 22px 0 0; color: #e6dff5; font-size: 1.05rem; }

    /* ---- roll ---- */
    /* Top padding sits under the band; bottom padding lets the last name rise
       clear of the lower fade before the cut. */
    #roll { padding: 196px 30px 170px; text-align: left; }
    #roll ol { list-style: none; margin: 0; padding: 0; }
    #roll li {
      display: grid; grid-template-columns: 44px 1fr; column-gap: 8px;
      padding: 7px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }
    #roll .n { grid-row: span 2; color: var(--gold); font-weight: 700; font-size: 1.05rem; text-align: right; }
    #roll .who { font-weight: 600; font-size: 1.12rem; line-height: 1.3; }
    #roll .gave { color: var(--mar); font-size: 1.02rem; line-height: 1.3; }

    #band { height: 960px; }
    #band .top {
      position: absolute; inset: 0 0 auto 0; padding: 34px 24px 70px;
      background: linear-gradient(to bottom, var(--ind-d) 62%, rgba(44, 35, 72, 0));
    }
    #band h2 { margin: 6px 0 0; font-family: var(--head); font-weight: 400; font-size: 1.55rem; line-height: 1.3; }
    #band .bottom {
      position: absolute; inset: auto 0 0 0; height: 150px;
      background: linear-gradient(to top, var(--ind-d) 20%, rgba(44, 35, 72, 0));
    }

    /* ---- thanks ---- */
    #thanks {
      height: 960px; padding: 84px 38px 0;
      background: radial-gradient(120% 70% at 50% 0%, rgba(232, 163, 61, 0.22), transparent 62%), var(--ind-d);
    }
    #thanks img { width: 112px; height: auto; }
    #thanks h2 {
      margin: 18px 0 0; font-family: var(--head); font-weight: 400;
      font-size: 1.9rem; line-height: 1.35;
    }
    #thanks .invite {
      margin: 34px 0 0; padding: 20px 18px; border-radius: 12px;
      background: rgba(255, 255, 255, 0.07); border: 1px solid rgba(201, 162, 39, 0.55);
    }
    #thanks .invite h3 { margin: 0; font-family: var(--head); font-weight: 400; font-size: 1.45rem; color: var(--gold); }
    #thanks .invite p { margin: 8px 0 0; font-size: 1.15rem; line-height: 1.45; }
    #thanks .invite .when { font-weight: 700; font-size: 1.4rem; }
    #thanks .url {
      display: inline-block; margin-top: 30px; padding: 12px 24px;
      border: 2px solid var(--gold); border-radius: 10px;
      font-weight: 700; font-size: 1.55rem;
    }
    #thanks .hint { margin: 8px 0 0; color: #e6dff5; font-size: 1rem; }
    #thanks .org { margin: 28px 0 0; color: var(--mar); font-size: 1.1rem; }
  </style>
</head>
<body>
  <section id="title">
    <div class="photo"></div>
    <div class="words">
      <p class="jai">॥ जय माता दी ॥</p>
      <h1>नवदुर्गा महोत्सव, नगर कन्या भोज एवं विशाल भंडारा <span class="year" data-year></span></h1>
      <p class="ord" data-ordinals></p>
      <p class="count"><span data-count></span> दानदाता</p>
    </div>
  </section>

  <section id="totals">
    <p class="jai">॥ जय माता दी ॥</p>
    <p class="big" data-count></p>
    <p>दानदाताओं का सहयोग</p>
    <dl data-totals></dl>
    <p class="also" data-also></p>
  </section>

  <section id="roll"><ol data-roll></ol></section>

  <section id="band">
    <div class="top">
      <p class="jai">॥ जय माता दी ॥</p>
      <h2>दानदाताओं की सूची · <span data-year></span></h2>
    </div>
    <div class="bottom"></div>
  </section>

  <section id="thanks">
    <img src="/assets/img/logo.png" alt="">
    <h2>समाज की ओर से सभी दानदाताओं का बहुत-बहुत धन्यवाद</h2>
    <div class="invite">
      <h3 data-event-title></h3>
      <p class="when" data-event-when></p>
      <p data-event-where></p>
      <p>आप सभी सादर आमंत्रित हैं</p>
    </div>
    <p class="url">lodhasamaj.org</p>
    <p class="hint">पूरी सूची: दान → <span data-year></span></p>
    <p class="org">आयोजक: श्री लोधा समाज इंदौर</p>
  </section>

  <script type="module">
    import { totals, formatTotal, typeLabel, presentTypes, displayName, formatItems }
      from '/assets/js/donors-core.js';

    const q = new URLSearchParams(location.search);
    const year = q.get('year') || '2026';
    const fill = (sel, text) => document.querySelectorAll(sel).forEach((el) => { el.textContent = text; });

    const [list, events] = await Promise.all([
      fetch(`/data/donors-${year}.json`).then((r) => r.json()),
      fetch('/data/events.json').then((r) => r.json()),
    ]);
    const donors = list.donors;
    const f = list.festival || {};

    fill('[data-year]', year);
    fill('[data-count]', String(donors.length));
    // events.json words the day as "नगर कन्या भोज", and so does the title above,
    // so the count beside it does too.
    fill('[data-ordinals]', [f.bhandara && `${f.bhandara}वां विशाल भंडारा`,
                             f.kanyaPujan && `${f.kanyaPujan}वां नगर कन्या भोज`]
      .filter(Boolean).join(' · '));

    document.querySelector('#title .photo').style.backgroundImage =
      `url("${q.get('photo') || '/assets/img/gallery/2026/pratima-2.jpg'}")`;

    // The cash leads: it is what a reader looks for first, and what the समाज's
    // own notices print first.
    const rows = totals(donors).sort((a, b) => (b.type === 'cash') - (a.type === 'cash'));
    const dl = document.querySelector('[data-totals]');
    for (const row of rows) {
      const box = document.createElement('div');
      const dt = document.createElement('dt');
      const dd = document.createElement('dd');
      dt.textContent = typeLabel(row.type, 'hi');
      dd.textContent = formatTotal(row, 'hi');
      box.append(dt, dd);
      dl.append(box);
    }
    // Gifts with no quantity (मिठाई, पत्तल) cannot be summed, but they were
    // given, so they are named rather than left off.
    const counted = new Set(rows.map((r) => r.type));
    const rest = presentTypes(donors).filter((t) => !counted.has(t)).map((t) => typeLabel(t, 'hi'));
    fill('[data-also]', rest.length ? `साथ में ${rest.join(', ')}` : '');

    const ol = document.querySelector('[data-roll]');
    donors.forEach((donor, i) => {
      const li = document.createElement('li');
      li.innerHTML = '<span class="n"></span><span class="who"></span><span class="gave"></span>';
      li.querySelector('.n').textContent = `${i + 1}.`;
      li.querySelector('.who').textContent = displayName(donor, 'hi');
      li.querySelector('.gave').textContent = formatItems(donor, 'hi');
      ol.append(li);
    });

    const ev = events.events.find((e) => e.titleHi.includes('भंडारा'));
    if (ev) {
      fill('[data-event-title]', ev.titleHi);
      fill('[data-event-when]', ev.when);
      fill('[data-event-where]', ev.where);
    }

    document.body.dataset.shot = q.get('shot') || 'title';
    await document.fonts.ready;
    document.body.dataset.ready = '1';
  </script>
</body>
</html>
